# syntax=docker/dockerfile:1.7
ARG GOLANG_IMAGE=golang:1.27.3-alpine
ARG ALPINE_IMAGE=alpine:3.21
FROM --platform=${BUILDPLATFORM} ${GOLANG_IMAGE} AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
COPY mediad/ ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w -X main.Version=${VERSION} -X main.Commit=${COMMIT}" -o /out/mediad ./cmd/mediad

FROM ${ALPINE_IMAGE}
ARG VERSION=dev
ARG COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/abellee/sub2api" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 mediad && adduser -D -u 1000 -G mediad mediad && \
    mkdir -p /app/data /app/media && chown -R mediad:mediad /app
WORKDIR /app
COPY --from=builder /out/mediad /app/mediad
USER mediad
ENV MEDIAD_LISTEN=:8090 MEDIAD_DATA_DIR=/app/data MEDIAD_RESULT_DIR=/app/media MEDIAD_PERSIST_CREDENTIALS=true
EXPOSE 8090
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -T 3 -O /dev/null http://127.0.0.1:8090/healthz || exit 1
ENTRYPOINT ["/app/mediad"]
