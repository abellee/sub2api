# Backend used by the Vite development proxy.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Local frontend-only login. Ignored by production builds even if set to true.
VITE_ENABLE_ADMIN_MOCK=false

# lotteryd WebSocket 地址（缺省由 VITE_LOTTERYD_BASE_URL 推导；vite ws 代理不稳时可显式直连）
# VITE_LOTTERYD_WS_URL=ws://127.0.0.1:18100
