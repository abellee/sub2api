# Copy outside the repository, chmod 600, and fill with the existing site's values.
# Keep the existing database, JWT secret, encryption keys and integration settings.
AUTO_SETUP=true
SERVER_MODE=release
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=REPLACE_ME
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_WITH_EXISTING_JWT_SECRET
TZ=Asia/Shanghai
# Other existing settings (media, audit, payment, auxiliary services, etc.) must
# be copied from the actual deployment; this is not a replacement for them.
