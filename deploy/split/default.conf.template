map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# /models is both a browser page and a gateway endpoint, just like embed_on.go.
map $http_accept $models_api {
    default 1;
    ~*text/html 0;
}

server {
    listen ${FRONTEND_LISTEN};
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 256m;

    # Trust only the explicitly configured outer reverse proxy, never arbitrary clients.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Resolve again after a backend container is recreated (Docker embedded DNS).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://${BACKEND_UPSTREAM};
    set $public_scheme ${PUBLIC_SCHEME};

    location = /frontend-health {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    location = /models {
        error_page 418 = @backend;
        if ($models_api) { return 418; }
        rewrite ^ /index.html last;
    }

    # API locations must precede the extension rule: media API paths may end in .png/.mp4.
    location ~ ^/(api|v1|v1beta|backend-api|antigravity|\.well-known|media|internal|m|responses|models|images|videos|custom-voices)(/|$) {
        include /etc/nginx/snippets/sub2api-proxy.conf;
    }
    location ~ ^/(setup/|contents/generations/tasks(?:/|$)|v3/contents/generations/tasks(?:/|$)) {
        include /etc/nginx/snippets/sub2api-proxy.conf;
    }
    location ~ ^/(health|chat/completions|embeddings|messages/count_tokens|alpha/search|web_search|x_search|tts|stt|realtime)$ {
        include /etc/nginx/snippets/sub2api-proxy.conf;
    }
    # Recorded CDN video paths can be arbitrary paths, outside /m/ or /videos/.
    location ~* \.(mp4|webm|mov|m3u8|ts)$ {
        try_files $uri @backend;
    }
    location @backend {
        include /etc/nginx/snippets/sub2api-proxy.conf;
    }

    # HTML keeps the backend's live CSP and public-page visibility policy.
    location = /_frontend_check {
        internal;
        proxy_pass $backend/internal/frontend/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Frontend-Path $request_uri;
        proxy_set_header Host $host;
        proxy_set_header Connection close;
    }
    location @disabled_page { return 404; }
    location = /index.html {
        auth_request /_frontend_check;
        auth_request_set $frontend_csp $upstream_http_content_security_policy;
        error_page 403 =404 @disabled_page;
        add_header Content-Security-Policy $frontend_csp always;
        add_header X-Frame-Options DENY always;
        add_header Cdn-Cache-Control no-store always;
        add_header Surrogate-Control no-store always;
        add_header Cache-Control 'no-store, no-cache, must-revalidate';
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    # Vite's hashed assets are immutable; missing assets must not return HTML.
    location ^~ /assets/ {
        try_files $uri @previous_asset;
        add_header Cache-Control 'public, max-age=31536000, immutable';
        add_header X-Content-Type-Options nosniff always;
    }
    location @previous_asset {
        root /usr/share/nginx/previous;
        try_files $uri =404;
        add_header Cache-Control 'public, max-age=31536000, immutable';
    }
    location ~* \.(js|mjs|css|map|json|png|jpg|jpeg|gif|svg|ico|webp|avif|woff2?|ttf|txt|xml|html)$ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
