# Compose variables, NOT application secrets. Replace the sample commit below.
FRONTEND_IMAGE=ghcr.io/abellee/sub2api-distributed-frontend:sha-REPLACE_WITH_COMMIT
BACKEND_IMAGE=ghcr.io/abellee/sub2api-distributed-backend:sha-REPLACE_WITH_COMMIT
BIND_HOST=127.0.0.1
FRONTEND_PORT=8080
# Set https behind the site's TLS reverse proxy.
PUBLIC_SCHEME=http
# Set to the actual outer proxy IP/CIDR. Do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Confirm this network does not overlap the host's networks before deployment.
SPLIT_SUBNET=172.30.80.0/24
SPLIT_FRONTEND_IP=172.30.80.2
BACKEND_ENV_FILE=/www/sub2api-split/backend.env
BACKEND_DATA_DIR=/www/sub2api-split/data
