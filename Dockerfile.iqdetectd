# syntax=docker/dockerfile:1.7
# =============================================================================
# iqdetectd image (IQ detection sidecar)
# =============================================================================
# Published separately from the main gateway image. Releases are cut from the
# dedicated feat/iqdetectd-release branch via iqdetectd-v* tags or a manual
# "Release iqdetectd" workflow run; a main-service release never rebuilds this
# image.
# =============================================================================

ARG GOLANG_IMAGE=golang:1.27.2-alpine
ARG ALPINE_IMAGE=alpine:3.21
ARG GOPROXY=https://goproxy.cn,direct
ARG GOSUMDB=sum.golang.google.cn

# Build on the native host arch and cross-compile. The binary is CGO_ENABLED=0.
FROM --platform=${BUILDPLATFORM} ${GOLANG_IMAGE} AS backend-builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE
ARG GOPROXY
ARG GOSUMDB
ARG TARGETOS
ARG TARGETARCH

ENV GOPROXY=${GOPROXY}
ENV GOSUMDB=${GOSUMDB}
ENV GOTOOLCHAIN=auto

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src

# lotteryd is a sibling module referenced by backend/go.mod. The replace
# path is ../lotteryd, which is /lotteryd when the module lives in /src.
COPY lotteryd/go.mod lotteryd/go.sum /lotteryd/

COPY backend/go.mod backend/go.sum ./
COPY backend/audit-sdk/ ./audit-sdk/
RUN --mount=type=cache,id=sub2api-iqdetectd-gomod,target=/go/pkg/mod \
    go mod download

COPY backend/ ./
COPY lotteryd/ /lotteryd/

RUN --mount=type=cache,id=sub2api-iqdetectd-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-iqdetectd-gobuild,target=/root/.cache/go-build \
    DATE_VALUE="${DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w -X main.Version=${VERSION} -X main.Commit=${COMMIT} -X main.Date=${DATE_VALUE}" \
    -trimpath \
    -o /out/iqdetectd \
    ./cmd/iqdetectd

FROM ${ALPINE_IMAGE}

LABEL maintainer="Wei-Shaw <github.com/Wei-Shaw>"
LABEL description="Sub2API IQ detection sidecar"
LABEL org.opencontainers.image.source="https://github.com/Wei-Shaw/sub2api"

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    su-exec \
    && rm -rf /var/cache/apk/*

RUN addgroup -g 1000 sub2api && \
    adduser -u 1000 -G sub2api -s /bin/sh -D sub2api

WORKDIR /app

COPY --from=backend-builder --chown=sub2api:sub2api /out/iqdetectd /app/iqdetectd

RUN mkdir -p /app/data/iqdetect && chown -R sub2api:sub2api /app/data

COPY deploy/iqdetectd-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh /app/iqdetectd

EXPOSE 18102

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q -T 5 -O /dev/null http://127.0.0.1:18102/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["-listen", "0.0.0.0:18102", "-sqlite-path", "/app/data/iqdetect/iqdetect.db"]
